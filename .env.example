# Environment variables declared in this file are automatically loaded by Prisma.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Local PostgreSQL database URL (update with your own credentials)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/longhorn_housing?schema=public"

# Optional: max connections for the app's `pg` pool (default: 10 dev, 1 on Vercel/serverless, 5 long-running prod)
# DATABASE_POOL_MAX=1

# For Supabase direct DB (migrations / Prisma CLI). For Next.js API routes in production, prefer the
# **transaction pooler** so many serverless instances share connections (port 6543), e.g.:
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# For Supabase non-pooled (not ideal for high-concurrency serverless):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Upstash Redis (production: shared rate limits + roommate match cache). If unset, the app falls back to in-memory (dev only).
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="..."

# Supabase Auth (required — get these from your Supabase project dashboard)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
